# PITR deposu (docs/PITR.md). Bu dosyayı backend kök dizinine `pitr.env` olarak kopyalayın (git'e GİRMEZ).
# S3 uyumlu herhangi bir depo: AWS S3, Cloudflare R2, Backblaze B2, Hetzner Object Storage, MinIO...
# Depo sunucudan AYRI bir sağlayıcıda/bölgede olmalı (sunucu kaybında yedek de kaybolmasın).
PGBACKREST_REPO1_TYPE=s3
PGBACKREST_REPO1_S3_ENDPOINT=s3.eu-central-1.amazonaws.com
PGBACKREST_REPO1_S3_REGION=eu-central-1
PGBACKREST_REPO1_S3_BUCKET=hashmark-pitr
# R2/MinIO/B2 gibi sağlayıcılar için genellikle path
PGBACKREST_REPO1_S3_URI_STYLE=host
PGBACKREST_REPO1_PATH=/hashmark
# Yalnızca bu bucket'a yazma/okuma/silme yetkili anahtar (yönetici anahtarı DEĞİL)
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
# İstemci tarafı şifreleme parolası: openssl rand -base64 48
# KAYBOLURSA YEDEKLER AÇILAMAZ → parola yöneticisinde ayrıca saklayın. Sağlayıcı bu parolayı hiç görmez.
PGBACKREST_REPO1_CIPHER_PASS=
