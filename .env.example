# ============================================
# Hashmark Production Environment Variables
# ============================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# ÖNEMLİ: .env dosyası GitHub'a gönderilmemelidir!
# ============================================

# === Server ===
SERVER_PORT=8080

# === PostgreSQL ===
POSTGRES_DB=hashmark
POSTGRES_USER=hashmark
POSTGRES_PASSWORD=

# === Database Connection (Docker Compose) ===
DATABASE_URL=jdbc:postgresql://postgres:5432/hashmark
DATABASE_USERNAME=hashmark
DATABASE_PASSWORD=
# Oturum sınırları (isteğe bağlı; varsayılanlar application.yml'de): kaçak sorgu / kilit bekleme / açık transaction
# DB_STATEMENT_TIMEOUT=30s
# DB_LOCK_TIMEOUT=10s
# DB_IDLE_IN_TX_TIMEOUT=60s
# Ayrı migrasyon rolü (boşsa DATABASE_USERNAME kullanılır). Bkz. docs/MIGRATIONS.md
# FLYWAY_USER=
# FLYWAY_PASSWORD=
# Postgres sunucu belleği (isteğe bağlı; varsayılanlar ~2–4 GB sunucu için). Bkz. docs/POSTGRES_TUNING.md
# PG_SHARED_BUFFERS=256MB
# PG_EFFECTIVE_CACHE_SIZE=768MB
# PG_WORK_MEM=8MB

# === GitHub OAuth ===
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://hashmark.yunusemremahir.com.tr/auth/callback

# === JWT ===
# En az 32 bayt rastgele: openssl rand -base64 48
JWT_SECRET=
# Anahtar dönüşünde eski anahtar(lar), virgülle. 7 gün (refresh süresi) sonra boşaltın. docs/KEY_ROTATION.md
JWT_PREVIOUS_SECRETS=

# === Encryption ===
# Önerilen: base64:<32 rastgele bayt> → echo "base64:$(openssl rand -base64 32)"  (eski biçim: tam 32 karakter)
ENCRYPTION_SECRET=
# Anahtar dönüşünde eski anahtar(lar), virgülle. Yeniden şifreleme işi bitince boşaltın. docs/KEY_ROTATION.md
ENCRYPTION_PREVIOUS_SECRETS=

# === CORS (virgülle ayrılmış origin'ler) ===
CORS_ALLOWED_ORIGINS=https://hashmark.yunusemremahir.com.tr

# === Brevo (E-posta) ===
# app.brevo.com -> SMTP & API -> API Keys. Gönderici adresi Brevo'da doğrulanmış olmalı.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@hashmark.dev
BREVO_SENDER_NAME=Hashmark
# E-postadaki panel bağlantısı için uygulamanın genel adresi
APP_URL=https://hashmark.yunusemremahir.com.tr
REPORT_TIMEZONE=Europe/Istanbul

# === Gözlemlenebilirlik ===
# Hata toplama (Sentry/GlitchTip uyumlu). Boş bırakılırsa hiçbir şey gönderilmez; kişisel veri gönderilmez.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Alarm bildirimi için monitoring/alertmanager.yml ve monitoring/secrets/telegram_token dosyalarına bakın.

# === Frontend (Next.js — build-time) ===
NEXT_PUBLIC_API_URL=https://hashmark.yunusemremahir.com.tr/api/v1
NEXT_PUBLIC_APP_URL=https://hashmark.yunusemremahir.com.tr
